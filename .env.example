# Copy to .env and fill in. Never commit .env.

# Public domain name (DNS A record must point to this server). Caddy gets HTTPS automatically.
DOMAIN=master.galenus.info
POSTGRES_PASSWORD=change-me-to-a-long-random-string
# Encrypts the AI API keys users save in Account settings. Changing it means users must re-enter them.
SECRETS_KEY=change-me-to-another-long-random-string

# Server default AI extraction provider: anthropic | openai | none.
# Each user can override it (own provider and key, or no AI) in Account settings.
AI_PROVIDER=anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5
# default = server-side refusal fallback on; off = disabled
ANTHROPIC_FALLBACKS=default
OPENAI_API_KEY=
OPENAI_MODEL=

# Optional: automated CompoundingToday download worker (the existing Render service)
FORMULA_AUTOMATION_URL=
FORMULA_AUTOMATION_API_KEY=

SESSION_TTL_HOURS=12
MAX_UPLOAD_MB=25
